kuminovvv.com {
	root * /var/www/kuminovvv.com/current
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
	}

	@fingerprinted path /_next/static/*
	header @fingerprinted Cache-Control "public, max-age=31536000, immutable"

	@fonts path /fonts/*
	header @fonts Cache-Control "public, max-age=86400"

	@html path_regexp html ^(/$|.*/$|.*\.html$)
	header @html Cache-Control "no-cache"

	file_server {
		precompressed br gzip
		hide .git .env .precompression-state.json
	}

	handle_errors {
		rewrite * /404.html
		file_server
	}
}

www.kuminovvv.com {
	redir https://kuminovvv.com{uri} permanent
}
