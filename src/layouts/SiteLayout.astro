---
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import { getPageMetadata } from "@/shared/lib/i18n/metadata";
import { localizeHref, stripLocale, type Locale } from "@/shared/lib/i18n/locale";
import "@/styles/globals.css";

type Props = {
  locale?: Locale;
  page?: "home" | "projects" | "contacts" | "resume" | "stack";
  title?: string;
  description?: string;
};

const {
  locale = "ru",
  page = "home",
  title,
  description,
} = Astro.props;

const meta = getPageMetadata(page, locale);
const pageTitle = title ?? meta.title;
const pageDescription = description ?? meta.description;
const canonical = meta.alternates?.canonical ?? "/";
const routePath = stripLocale(canonical);
const canonicalPath = localizeHref(routePath, locale);
const canonicalUrl = new URL(canonicalPath, "https://kuminovvv.com").href;
const og = meta.openGraph;
const ogTitle = og && "title" in og ? og.title : pageTitle;
const ogDescription = og && "description" in og ? og.description : pageDescription;
---

<!doctype html>
<html lang={locale} class="h-full antialiased" data-site-motion="on">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="ru" href={localizeHref(routePath, "ru")} />
    <link rel="alternate" hreflang="en" href={localizeHref(routePath, "en")} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content="https://kuminovvv.com/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={locale === "en" ? "en_US" : "ru_RU"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <link rel="icon" href="/icon.svg" sizes="any" type="image/svg+xml" />
    <script is:inline>
      (() => {
        const html = document.documentElement;
        try {
          if (localStorage.getItem("portfolio-theme") === "dark") html.classList.add("dark");
          if (localStorage.getItem("portfolio-motion") === "off") html.dataset.siteMotion = "off";
        } catch {}
        try {
          const key = "portfolio-language-navigation";
          const target = sessionStorage.getItem(key);
          sessionStorage.removeItem(key);
          if (target === location.pathname + location.search + location.hash) {
            html.dataset.skipPortfolioMotion = "true";
          }
        } catch {}
        if (!location.hash && html.dataset.skipPortfolioMotion !== "true") {
          html.dataset.introMotion = "true";
        }
      })();
    </script>
    <slot name="head" />
  </head>
  <body class="min-h-full">
    <a
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:rounded-full focus:bg-site-surface focus:px-5 focus:py-3 focus:text-site-text"
      href="#main-content">Перейти к содержимому</a
    >
    <div id="top" data-site-layout class="flow-root min-h-screen bg-site-canvas font-sans text-site-text">
      <SiteHeader locale={locale} />
      <main
        id="main-content"
        class="mx-auto w-[calc(100%-40px)] max-w-340 max-[900px]:w-[calc(100%-32px)] max-[680px]:w-[calc(100%-24px)] [&_[id]]:scroll-mt-30 max-[680px]:[&_[id]]:scroll-mt-26"
      >
        <slot />
      </main>
      <SiteFooter locale={locale} />
    </div>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const toggle = document.querySelector("[data-theme-toggle]");
        const syncThemeButton = () => {
          if (!(toggle instanceof HTMLButtonElement)) return;
          const isDark = root.classList.contains("dark");
          toggle.setAttribute("aria-pressed", String(isDark));
          toggle.setAttribute("aria-label", isDark ? "Включить светлую тему" : "Включить тёмную тему");
        };
        toggle?.addEventListener("click", () => {
          const next = !root.classList.contains("dark");
          root.classList.toggle("dark", next);
          try { localStorage.setItem("portfolio-theme", next ? "dark" : "light"); } catch {}
          syncThemeButton();
        });
        window.addEventListener("storage", (event) => {
          if (event.key !== "portfolio-theme") return;
          root.classList.toggle("dark", event.newValue === "dark");
          syncThemeButton();
        });
        syncThemeButton();

        document.querySelectorAll("[data-language]").forEach((link) => {
          link.addEventListener("click", () => {
            try { localStorage.setItem("portfolio-locale", link.getAttribute("data-language") ?? "ru"); } catch {}
          });
        });
      })();
    </script>
    <script is:inline>
      (() => {
        const menu = document.querySelector("[data-mobile-menu]");
        if (!(menu instanceof HTMLDetailsElement)) return;
        menu.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => { menu.open = false; }));
        document.addEventListener("click", (event) => {
          if (menu.open && event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
        });
        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape") menu.open = false;
        });
      })();
    </script>
  </body>
</html>
