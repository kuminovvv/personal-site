---
import LanguageSwitcher from "@/components/LanguageSwitcher.astro";
import { getSiteNavigation } from "@/shared/config/site-navigation";
import { getCopy } from "@/widgets/site-header/model/copy";
import { stripLocale, type Locale } from "@/shared/lib/i18n/locale";

type Props = { locale?: Locale };

const { locale = "ru" } = Astro.props;
const copy = getCopy(locale);
const navigation = getSiteNavigation(locale);
const pathname = stripLocale(Astro.url.pathname).replace(/\/+$/, "") || "/";

const isActive = (href: string) => {
  const target = stripLocale(href).replace(/\/+$/, "") || "/";
  return pathname === target || (target !== "/" && pathname.startsWith(`${target}/`));
};
---

<header class="sticky top-4 z-50 mx-auto mt-4 flex min-h-20.25 w-[calc(100%-40px)] max-w-340 items-center justify-between gap-4 rounded-full bg-site-surface p-4 max-[900px]:w-[calc(100%-32px)] max-[900px]:rounded-[28px] max-[540px]:min-h-17 max-[540px]:w-[calc(100%-24px)] max-[540px]:p-2.5">
  <a
    class="whitespace-nowrap px-5 font-heading text-[24px] font-black text-site-text max-[1180px]:px-2.5 max-[1180px]:text-[19px] max-[540px]:px-1.5 max-[540px]:text-[16px]"
    href={locale === "en" ? "/en/" : "/"}
    aria-label={copy.home}
  >
    Kuminovvv
  </a>

  <nav class="flex items-center gap-1 max-[1100px]:hidden" aria-label={copy.nav}>
    {
      navigation.map(({ label, href }) => (
        <a
          aria-current={isActive(href) ? "page" : undefined}
          class={`inline-flex min-h-12.25 items-center justify-center whitespace-nowrap rounded-full px-8 text-[16px] max-[1180px]:px-4.25 max-[1180px]:text-[14px] ${
            isActive(href)
              ? "bg-site-green text-site-on-green"
              : "text-site-text hover:bg-site-soft"
          }`}
          href={href}
        >
          {label}
        </a>
      ))
    }
  </nav>

  <div class="flex items-center gap-2">
    <div class="max-[540px]:hidden">
      <LanguageSwitcher locale={locale} />
    </div>
    <button
      aria-label={copy.dark}
      aria-pressed="false"
      class="inline-flex h-12.25 min-h-12.25 w-29 shrink-0 cursor-pointer items-center justify-center gap-2 rounded-full border-0 bg-site-soft px-3 text-[12px] text-site-text outline-none dark:bg-site-canvas focus-visible:underline focus-visible:underline-offset-4 max-[540px]:size-11 max-[540px]:min-h-11 max-[540px]:p-0"
      data-theme-toggle
      type="button"
    >
      <span aria-hidden="true" class="size-5.25 shrink-0 rounded-full bg-site-text"></span>
      <span class="dark:hidden max-[540px]:hidden">{copy.darkLabel}</span>
      <span class="hidden dark:inline max-[540px]:dark:hidden">{copy.lightLabel}</span>
    </button>
    <a
      class="inline-flex min-h-12.25 items-center justify-center gap-1 whitespace-nowrap rounded-full border-0 bg-site-soft px-5 text-[16px] font-normal text-site-text hover:bg-site-sage dark:bg-site-canvas dark:hover:bg-site-canvas max-[1180px]:px-3.5 max-[1180px]:text-[14px] max-[1100px]:hidden [&_svg]:shrink-0 [&_svg]:stroke-current"
      href={locale === "en" ? "/en/contacts" : "/contacts"}
    >
      {copy.action}
      <svg
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        color="currentColor"
        stroke-width="1.5"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <path
          d="M9 6.65032C9 6.65032 15.9383 6.10759 16.9154 7.08463C17.8924 8.06167 17.3496 15 17.3496 15M16.5 7.5L6.5 17.5"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </a>
  </div>

  <details class="relative order-2 hidden max-[1100px]:block" data-mobile-menu>
    <summary
      class="cursor-pointer list-none rounded-full bg-site-soft px-4 py-3 marker:hidden max-[540px]:px-3 max-[540px]:py-2.75 max-[540px]:text-[13px] [&::-webkit-details-marker]:hidden"
    >
      {copy.menu}
    </summary>
    <nav
      class="absolute top-12 right-0 z-10 grid min-w-45 rounded-[18px] bg-site-surface p-3 shadow-[0_14px_40px_var(--site-catalog-accent)]"
      aria-label={copy.mobile}
    >
      {
        navigation.map(({ label, href }) => (
          <a
            aria-current={isActive(href) ? "page" : undefined}
            class="rounded-[10px] px-3 py-2.5 text-site-text hover:bg-site-accent-soft aria-[current=page]:bg-site-green aria-[current=page]:text-site-on-green"
            href={href}
          >
            {label}
          </a>
        ))
      }
      <div class="hidden px-3 max-[540px]:block">
        <LanguageSwitcher locale={locale} />
      </div>
    </nav>
  </details>
</header>
