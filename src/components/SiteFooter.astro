---
import LanguageSwitcher from "@/components/LanguageSwitcher.astro";
import { getSiteFooterNavigation } from "@/shared/config/site-navigation";
import { getSiteContent } from "@/shared/lib/content/get-site-content";
import type { Locale } from "@/shared/lib/i18n/locale";

type Props = { locale?: Locale };

const { locale = "ru" } = Astro.props;
const content = getSiteContent(locale);
const footer = content.footer;
const channels = content.home.contacts.channels;
const email = channels.find((channel) => channel.kind === "EMAIL");
const telegram = channels.find((channel) => channel.kind === "TELEGRAM");
const navigation = getSiteFooterNavigation(locale);
---

<footer class="mx-auto mt-15 mb-6 w-[calc(100%-40px)] max-w-340 rounded-[30px] bg-site-contact-surface p-8 text-site-footer-surface projects:mt-6.5 stack:mt-8 max-[580px]:mt-10 max-[580px]:w-[calc(100%-24px)] max-[580px]:p-6">
  <div class="grid min-h-53.75 grid-cols-[1.2fr_1fr_.8fr] gap-12 max-[850px]:grid-cols-2 max-[580px]:grid-cols-1 max-[580px]:gap-7.5">
    <div class="max-[850px]:col-span-2 max-[580px]:col-span-1">
      <div class="flex items-center gap-2">
        <strong class="grid size-15.5 place-items-center rounded-[17px] bg-site-green font-heading text-[27px] font-black text-site-contact-accent">K.</strong>
        <span class="grid gap-0.75">
          <b class="font-heading text-[29px] font-bold max-[580px]:text-[22px]">{footer.brand}</b>
          <small class="text-[13px] text-site-contact-text">{footer.subtitle}</small>
        </span>
      </div>
      <p class="my-4 text-[16px] text-site-contact-text">{footer.description}</p>
      <span class="inline-block rounded-full bg-site-footer-surface-b px-3.75 py-3 text-[11px] text-white">{footer.tag}</span>
    </div>
    <div>
      <h2 class="mb-7 font-sans! text-[12px]! font-semibold! tracking-normal! text-site-green">{footer.navigationTitle}</h2>
      <div class="grid max-w-92.5 grid-cols-2 gap-x-5.5 gap-y-4.5">
        {
          navigation.map((item) => (
            <a class="text-[16px] text-white hover:text-site-green" href={item.footerHref}>
              {item.footerLabel}
            </a>
          ))
        }
      </div>
    </div>
    <div class="flex flex-col items-start">
      <h2 class="mb-7 font-sans! text-[12px]! font-semibold! tracking-normal! text-site-green">{footer.contactTitle}</h2>
      {
        email && (
          <>
            <span class="mb-0.5 text-[13px] text-site-footer-text">Email</span>
            <a class="mb-5.5 text-[16px] text-white hover:text-site-green" href={email.href}>{email.title}</a>
          </>
        )
      }
      {
        telegram && (
          <>
            <span class="mb-0.5 text-[13px] text-site-footer-text">Telegram</span>
            <a class="mb-5.5 text-[16px] text-white hover:text-site-green" href={telegram.href} target="_blank" rel="noopener noreferrer">{telegram.title}</a>
          </>
        )
      }
    </div>
  </div>
  <div class="grid grid-cols-[1fr_1.8fr_auto] items-center border-t border-site-footer-border pt-7 text-[13px] text-site-contact-text max-[580px]:grid-cols-[1fr_auto] max-[580px]:gap-4">
    <span>{footer.copyright}</span>
    <div class="flex flex-wrap items-center gap-4">
      <span class="max-[580px]:hidden">{footer.note}</span>
      <LanguageSwitcher locale={locale} />
    </div>
    <a class="inline-flex h-10.5 min-w-40 items-center justify-center gap-4 rounded-full bg-site-footer-surface-b px-5 text-[13px] font-normal text-white hover:bg-site-footer-surface-b max-[580px]:min-w-0" href="#top">
      {footer.topLabel}
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M9 6.65032C9 6.65032 15.9383 6.10759 16.9154 7.08463C17.8924 8.06167 17.3496 15 17.3496 15M16.5 7.5L6.5 17.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </a>
  </div>
</footer>
