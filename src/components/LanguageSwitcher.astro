---
import { localizeHref, stripLocale, type Locale } from "@/shared/lib/i18n/locale";

type Props = {
  locale: Locale;
  className?: string;
};

const { locale, className = "" } = Astro.props;
const pathname = stripLocale(Astro.url.pathname);
const href = (language: Locale) => localizeHref(pathname, language);
const label = locale === "ru" ? "Язык" : "Language";
---

<nav
  aria-label={label}
  class={`inline-flex shrink-0 items-center gap-2 text-[12px] ${className}`}
>
  {
    (["ru", "en"] as const).map((language, index) => (
      <span class="inline-flex items-center gap-2">
        {index === 1 && <span aria-hidden="true" class="opacity-40">/</span>}
        <a
          aria-current={locale === language ? "true" : undefined}
          aria-label={language === "ru" ? "Русский" : "English"}
          class="inline-flex min-h-11 items-center font-semibold opacity-60 hover:opacity-100 aria-[current=true]:opacity-100 aria-[current=true]:underline aria-[current=true]:underline-offset-4 focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-current"
          data-language={language}
          href={href(language)}
          hreflang={language}
          lang={language}
        >
          {language.toUpperCase()}
        </a>
      </span>
    ))
  }
</nav>
