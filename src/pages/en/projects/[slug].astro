---
import SiteLayout from "@/layouts/SiteLayout.astro";
import { ProjectCasePage } from "@/widgets/project-case";
import { englishProjectCases } from "@/shared/config/project-cases.en";
import type { ProjectCase } from "@/shared/config/project-cases";
import { createPageMetadata } from "@/shared/lib/i18n/metadata";

export const getStaticPaths = () =>
  englishProjectCases.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));

type Props = { project: ProjectCase };

const { project } = Astro.props;
const locale = "en" as const;
const meta = createPageMetadata(
  locale,
  `/projects/${project.slug}`,
  `${project.title} — Kuminovvv projects`,
  project.description,
);
---

<SiteLayout locale={locale} page="projects" title={meta.title} description={meta.description}>
  <ProjectCasePage project={project} locale={locale} />
</SiteLayout>
